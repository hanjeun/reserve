# 이 파일을 복사해서 .env.local로 사용하세요
# cp .env.example .env.local

# 백엔드 API 주소
VITE_API_BASE_URL=http://localhost:8080

# 포트원 채널 키 (포트원 콘솔 → 채널 관리에서 확인)
VITE_PORTONE_CHANNEL_KEY=

# 카카오맵 Web(JavaScript) SDK 키. 카카오 개발자 콘솔에 localhost와 운영 도메인을 등록하세요.
VITE_KAKAO_JS_KEY=

# 스켈레톤 딜레이 (개발 중 스켈레톤 확인용, 배포 시 제거)
# VITE_SKELETON_DELAY=300
