# .gitignore

# ========================
# Java / Gradle
# ========================
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/

# ========================
# IDE
# ========================
.idea/
.vscode/
*.iws
*.iml
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# STS (Spring Tool Suite)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ========================
# Node / Frontend
# ========================
node_modules/
dist/
dist-ssr/
test-results/
playwright-report/
blob-report/

# ========================
# 환경변수 (보안)
# ========================
.env
.env.local
.env.production
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.production

# application-secret.yml 은 여기에 넣지 않는다.
# 이미 추적 중인 파일이라 .gitignore가 효력이 없고(거짓 안심), application.yml이
# secret 프로파일을 include하므로 레포에 있어야 앱이 뜬다.
# 그 파일에는 실제 값 대신 ${ENV_VAR} 플레이스홀더만 적는다 — 값은 배포 환경변수로 주입.

# ========================
# 로그
# ========================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# OS 시스템 파일
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# 기타
# ========================
HELP.md
cookies.txt
*.deprecated.jsx
*.unused
# ========================
# 에이전트 로컬 지침
# ========================
# AGENTS.md 는 CLAUDE.md 전체 + Cowork 프로젝트 지침을 합친 **로컬 전용** 파일이다.
# 레포에 올리면 같은 규칙이 두 파일에 중복돼 한쪽만 고쳐지므로 추적하지 않는다.
# 레포의 정본은 CLAUDE.md 다. (2026-09-01 결정)
AGENTS.md
