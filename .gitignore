# .gitignore

# ========================
# Java / Gradle
# ========================
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/

# ========================
# IDE
# ========================
.idea/
.vscode/
*.iws
*.iml
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# STS (Spring Tool Suite)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ========================
# Node / Frontend
# ========================
node_modules/
dist/
dist-ssr/

# ========================
# 환경변수 (보안)
# ========================
.env
.env.local
.env.production
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.production
backend/src/main/resources/application-secret.yml
backend/src/main/resources/application-local.yml

# ========================
# 업로드 파일
# ========================
uploads/
backend/data/

# ========================
# 로그
# ========================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# OS 시스템 파일
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# 기타
# ========================
HELP.md
cookies.txt
*.deprecated.jsx
*.unused
