# .gitignore

# ========================
# Java / Gradle
# ========================
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/

# ========================
# IDE
# ========================
.idea/
.vscode/
*.iws
*.iml
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# STS (Spring Tool Suite)
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ========================
# Node / Frontend
# ========================
node_modules/
dist/
dist-ssr/
test-results/
playwright-report/
blob-report/
/frontend/coverage/

# ========================
# 환경변수 (보안)
# ========================
.env
.env.local
.env.production
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.production

# application-secret.yml 은 여기에 넣지 않는다.
# 이미 추적 중인 파일이라 .gitignore가 효력이 없고(거짓 안심), application.yml이
# secret 프로파일을 include하므로 레포에 있어야 앱이 뜬다.
# 그 파일에는 실제 값 대신 ${ENV_VAR} 플레이스홀더만 적는다 — 값은 배포 환경변수로 주입.

# ========================
# 로그
# ========================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# OS 시스템 파일
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
# 기타
# ========================
HELP.md
cookies.txt
*.deprecated.jsx
*.unused
# ========================
# 에이전트 로컬 지침
# ========================
# AI 에이전트용 로컬 지침은 저장소에 올리지 않는다.
AGENTS.md
CLAUDE.md

# ========================
# README 실화면 캡처용 임시 로그인 상태 (capture-readme-live.mjs --login)
# ========================
# 세션 쿠키(리프레시 토큰 포함)가 들어 있다. npm run capture:readme:clean 전까지 남아 있으니 절대 올라가지 않게 막는다.
frontend/.readme-capture/
docs/images/.*.tmp
docs/images/*.new.png

# 내부 계획·작업 기록은 PC에 보관하고 공개 저장소에는 포함하지 않는다.
/docs/private/
/docs/technical/quality-roadmap.md
/docs/technical/current-status.md
/docs/technical/preview-release-plan.md
/docs/technical/api-versioning.md
/docs/technical/modularization-plan.md
/docs/technical/history/
/Claude outputs/

/coverage/
