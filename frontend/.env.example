# 이 파일을 복사해서 .env.local로 사용하세요
# cp .env.example .env.local

# 백엔드 API 주소
VITE_API_BASE_URL=http://localhost:8080

# API v1을 지원하는 백엔드로 전환한 뒤 v1로 설정하세요. 구 백엔드는 legacy를 유지합니다.
VITE_API_VERSION=legacy

# 앱·공개 가게 canonical·홍보 주소. 도메인 전환 전에는 기존 값을 유지하세요.
VITE_APP_ORIGIN=https://reserve.it.kr
VITE_MARKETING_ORIGIN=https://reserve.it.kr
VITE_LEGACY_APP_ORIGIN=https://reserve.it.kr

# 포트원 채널 키 (포트원 콘솔 → 채널 관리에서 확인)
VITE_PORTONE_CHANNEL_KEY=
VITE_PORTONE_TOSS_CHANNEL_KEY=
VITE_PORTONE_TOSSPAY_CHANNEL_KEY=
# 네이버페이 결제형 전용 채널이에요. KCP·토스의 간편결제보다 우선해요.
VITE_PORTONE_NAVERPAY_CHANNEL_KEY=
# 개인 Npay 샌드박스는 이 TEST 전용 항목에 연결해요. 개발 서버의 TEST 모드에서만 사용해요.
VITE_PORTONE_NAVERPAY_TEST_CHANNEL_KEY=
# 로컬 개발 서버의 TEST 카드만 KCP로 연결해요. 배포 빌드는 이 값을 사용하지 않아요.
VITE_PORTONE_KCP_TEST_CHANNEL_KEY=
# KCP MID에서 이용 가능한 수단을 확인한 뒤에만 지정해요. 공용 MID는 전체 수단을 지원하지 않아요.
VITE_PORTONE_KCP_TEST_EASY_PAY_PROVIDERS=
# 해당 토스 MID에서 사용을 확인한 간편결제만 쉼표로 구분해요.
VITE_PORTONE_TOSS_EASY_PAY_PROVIDERS=
# 개발 서버에서만 미확인 간편결제를 시험해요. 배포 빌드에는 적용하지 않아요.
VITE_PORTONE_PAYMENT_ENV=
VITE_PORTONE_TOSS_TEST_EASY_PAY_PROVIDERS=

# 카카오맵 Web(JavaScript) SDK 키. 카카오 개발자 콘솔에 localhost와 운영 도메인을 등록하세요.
VITE_KAKAO_JS_KEY=

# 스켈레톤 딜레이 (개발 중 스켈레톤 확인용, 배포 시 제거)
# VITE_SKELETON_DELAY=300
